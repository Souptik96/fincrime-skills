{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fincrime.dev/contracts/skill-manifest/1.0.0",
  "title": "FinCrime Skill Manifest",
  "description": "Schema for the fincrime.skill.yaml sidecar. The sidecar is the machine-readable contract of a skill. It is additive: a host that knows nothing about FinCrime loads SKILL.md and works. See ADR-0001 and the skill format specification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "fincrime.dev/v1" },
    "kind": { "const": "FinCrimeSkill" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "owners", "license", "jurisdiction_scope"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": { "enum": ["draft", "stable", "deprecated", "maintenance_required"] },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "type": "string", "minLength": 1 },
        "jurisdiction_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 },
          "description": "A skill with an empty or 'global' scope is invalid. Regulatory content is never jurisdiction-agnostic."
        },
        "created": { "type": "string" },
        "contract_version": { "type": "string", "minLength": 1 },
        "knowledge_pack": { "type": "string", "minLength": 1 },
        "related_skills": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "inputs",
        "preconditions",
        "procedure",
        "output",
        "policies",
        "knowledge",
        "evaluation",
        "safety"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "array", "items": { "$ref": "#/$defs/input" } },
            "optional": { "type": "array", "items": { "$ref": "#/$defs/input" } }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        },
        "procedure": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        },
        "output": { "$ref": "#/$defs/output" },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "array", "items": { "type": "string" } },
            "optional": { "type": "array", "items": { "type": "string" } }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indicators": { "type": "array", "items": { "type": "string" } },
            "scenarios": { "type": "array", "items": { "type": "string" } },
            "typologies": { "type": "array", "items": { "type": "string" } },
            "regulatory": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["suite", "case_count_min", "gates"],
          "properties": {
            "suite": { "type": "string", "minLength": 1 },
            "case_count_min": { "type": "integer", "minimum": 1 },
            "gates": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_approval_required",
            "prohibited_actions",
            "closed_world"
          ],
          "properties": {
            "human_approval_required": {
              "type": "array",
              "items": { "type": "string" }
            },
            "prohibited_actions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "closed_world": { "const": true },
            "pii_policy": { "enum": ["reference_only", "redact", "none"] }
          }
        }
      }
    }
  },
  "$defs": {
    "outputElement": {
      "enum": [
        "fact",
        "observation",
        "indicator",
        "hypothesis",
        "risk_assessment",
        "recommendation",
        "decision",
        "frame",
        "evidence_inventory",
        "gaps",
        "contradiction",
        "timeline",
        "escalation",
        "draft_notice"
      ],
      "description": "An element of the Finding Contract: one of the seven claim classes, or one of the structural sections an artifact carries."
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "contract_ref": {
          "type": "string",
          "pattern": "^fincrime/[a-z-]+/[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "The contract this input conforms to, by contract id. A skill is distributed on its own, without the repository, so it must be able to name the contract it needs rather than point at a path inside someone else's checkout."
        }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "on_fail", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^PC-[0-9]+$" },
        "check": { "type": "string", "minLength": 1 },
        "on_fail": { "enum": ["stop", "annotate", "escalate"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "name", "produces", "requires"],
      "properties": {
        "stage": {
          "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"]
        },
        "name": { "type": "string", "minLength": 1 },
        "produces": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputElement" },
          "description": "Claim classes or structural sections this stage may emit."
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "guard": { "type": ["string", "null"] },
        "on_violation": { "enum": ["stop", "escalate", "annotate"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "artifact",
        "required_claims",
        "prohibited_claims",
        "min_hypotheses",
        "require_benign_hypothesis",
        "confidence"
      ],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "required_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputElement" }
        },
        "optional_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputElement" }
        },
        "prohibited_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputElement" }
        },
        "min_hypotheses": { "type": "integer", "minimum": 0 },
        "require_benign_hypothesis": { "type": "boolean" },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["levels", "default_ceiling"],
          "properties": {
            "levels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": ["high", "moderate", "low", "insufficient_information"]
              }
            },
            "default_ceiling": { "enum": ["high", "moderate", "low"] }
          }
        }
      }
    }
  }
}
